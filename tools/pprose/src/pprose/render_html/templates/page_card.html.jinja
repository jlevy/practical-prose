<div class="bi-card">
  <p class="doc-kicker">Practical Prose Evaluation</p>
  <h1 class="doc-name">{{ doc_name }}</h1>
  {% if doc_meta %}
  <p class="doc-meta">{{ doc_meta }}</p>
  {% endif %}

  <div class="bi-grid">
    {% for col in columns %}
    <div class="bi-col {{ col.side }}">
      {% for group in col.groups %}
      <div class="bi-group-header" style="color: var(--accent-{{ group.key }});">
        <span class="grp-icon" aria-hidden="true">{{ group.icon }}</span>
        <span class="label">{{ group.label }}</span>
        {% if group.avg is not none %}
        <span class="bi-group-avg">{{ "%.1f" | format(group.avg) }}</span>
        {% endif %}
      </div>
      {% for dim in group.dims %}
      <div class="bi-dim {% if dim.is_na %}is-na{% endif %} {% if dim.is_err %}is-err{% endif %}"
           style="--row-color: var(--dim-{{ dim.key }});">
        <div class="bi-dim-head">
          <span class="bi-dim-name">{{ dim.label }}</span>
          <span class="bi-dim-score">{{ dim.score_display }}</span>
        </div>
        <div class="bi-bar-track">
          <div class="bi-bar-fill" style="width: {{ dim.fill_pct }}%;"></div>
        </div>
      </div>
      {% endfor %}
      {% endfor %}
    </div>
    {% endfor %}
  </div>

  {% if overall_mean is not none %}
  <div class="doc-rollup">
    <span class="label">Overall mean</span>
    <span class="value">{{ "%.2f" | format(overall_mean) }}</span>
  </div>
  {% endif %}
</div>
