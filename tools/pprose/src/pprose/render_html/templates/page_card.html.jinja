{# Mirrors biCard() + biDim9B() in tools/explorations/visual-design/dimension-visualizations.html. #}
<div class="bi-stack bi-ltr">
  <div class="bi-card">
    <div class="doc-kicker">Practical Prose Evaluation</div>
    <div class="doc-name">{{ doc_name }}</div>
    <div class="bi-grid">
      {% for col in columns %}
      <div class="bi-col {{ col.side }}">
        {% for group in col.groups %}
        <div class="bi-group-header" style="color: var(--icon-color, var(--accent-{{ group.key_lower }}));">
          {% if col.side == 'left' %}
          <span class="grp-icon {{ group.key_lower }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><use href="#icon-{{ group.label_lower }}"/></svg>
          </span>
          <span class="label">{{ group.label }}</span>
          {% else %}
          <span class="label">{{ group.label }}</span>
          <span class="grp-icon {{ group.key_lower }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><use href="#icon-{{ group.label_lower }}"/></svg>
          </span>
          {% endif %}
          {% if group.avg is not none %}
          <span class="bi-group-avg">{{ "%.1f" | format(group.avg) }}</span>
          {% endif %}
        </div>
        {% for dim in group.dims %}
        <div class="bi-dim {{ col.side }}{% if dim.is_na %} is-na{% endif %}"
             style="color: var(--dim-{{ dim.id }});">
          <div class="bi-dim-head">
            <span class="bi-dim-name">{{ dim.label }}</span>
            <div class="bi-num-circle{% if dim.is_na %} na{% elif dim.is_err %} err{% endif %}"
                 {% if dim.circle_bg %}style="background: {{ dim.circle_bg }};"{% endif %}>{{ dim.score_display }}</div>
          </div>
          <div class="bi-bar-track">
            {% if dim.segments %}
            {% for seg in dim.segments %}
            <div class="bi-bar-seg" data-seg="{{ seg.idx }}"
                 style="background: {{ seg.background }}; {{ 'right' if col.side == 'left' else 'left' }}: {{ seg.offset_pct }}%;"></div>
            {% endfor %}
            {% else %}
            <div class="bi-bar-fill" style="width: 100%; background: {{ dim.fill_bg }};"></div>
            {% endif %}
            {% for tick_pct in dim.tick_positions %}
            <div class="bi-tick" style="left: {{ tick_pct }}%;"></div>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
