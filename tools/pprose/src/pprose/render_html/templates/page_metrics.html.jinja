<h2>Quantitative Metrics</h2>

<div class="metrics-grid">
  {% for stat in stats %}
  <div class="stat">
    <span class="stat-value">{{ stat.value }}</span>
    <span class="stat-label">{{ stat.label }}</span>
  </div>
  {% endfor %}
</div>

{% if ratios %}
<ul class="ratios">
  {% for r in ratios %}
  <li>
    <span class="ratio-label">{{ r.label }}</span>
    <span class="ratio-value">{{ r.value }}</span>
  </li>
  {% endfor %}
</ul>
{% endif %}
